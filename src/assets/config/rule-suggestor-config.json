  "rulePatterns": [
    {
      "id": "null-or-empty",
      "name": "Null or Empty Check",
      "description": "Produce error when a field is null or empty",
      "exampleText": "Produce Error If <Contract Identifier> is null or empty",
      "nextSuggestions": ["phrase", "dataElement", "operator", "value", "connector"],
      "sampleDroolsWhen": "$contract : Contract( identifier == null || identifier == \"\" )"
    },
    {
      "id": "length-check",
      "name": "Length Check",
      "description": "Produce error when length exceeds or is below threshold",
      "exampleText": "Produce Error If <Contract Identifier> is not null or empty and length > 40",
      "nextSuggestions": ["phrase", "dataElement", "operator", "value", "connector"],
      "sampleDroolsWhen": "$contract : Contract( identifier != null && identifier.length() > 40 )"
    },
    {
      "id": "equality",
      "name": "Equality Check",
      "description": "Produce error when value equals or not equals",
      "exampleText": "Produce Error If <Balance> equals 0",
      "nextSuggestions": ["phrase", "dataElement", "operator", "value", "connector"],
      "sampleDroolsWhen": "$account : Account( balance == 0 )"
    },
    {
      "id": "range",
      "name": "Range / Relational",
      "description": "Produce error when value is outside range",
      "exampleText": "Produce Warning If <Transaction Amount> > 10000",
      "nextSuggestions": ["phrase", "dataElement", "operator", "value", "connector"],
      "sampleDroolsWhen": "$txn : Transaction( amount > 10000 )"
    }
  ],
  "sampleRules": [
    {
      "id": "sample-1",
      "label": "Contract ID null or empty",
      "ruleText": "Produce Error If Contract Identifier is null or empty",
      "droolsWhen": "<Deposits.Deposits Contract>:(Contract Identifier == null || Contract Identifier == \"\")"
    },
    {
      "id": "sample-2",
      "label": "Contract ID length > 40",
      "ruleText": "Produce Error If Contract Identifier is not null or empty and length greater than 40",
      "droolsWhen": "<Deposits.Deposits Contract>:(Contract Identifier != null && Contract Identifier.length() > 40)"
    },
    {
      "id": "sample-3",
      "label": "Balance equals zero",
      "ruleText": "Produce Error If Balance equals 0",
      "droolsWhen": "<Deposits.Deposits Account>:(Balance == 0)"
    },
    {
      "id": "sample-4",
      "label": "Multiple conditions - different entities",
      "ruleText": "Produce Error If Contract Identifier is empty and Account Number is null",
      "droolsWhen": "<Deposits.Deposits Contract>:(Contract Identifier == \"\") , <Deposits.Deposits Account>:(Account Number == null)"
    },
    {
      "id": "sample-5",
      "label": "Multiple conditions - same entity",
      "ruleText": "Produce Error If Account Number equals 100 and Balance greater than 50",
      "droolsWhen": "<Deposits.Deposits Account>:(Account Number == 100 , Balance > 50)"
    }
  ],
